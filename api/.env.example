# VoltPass Smartcar connector — server-side only. NEVER expose these to the
# frontend. Copy to `.env` and fill in your Smartcar application credentials.

# From your Smartcar dashboard (https://dashboard.smartcar.com)
SMARTCAR_CLIENT_ID=
SMARTCAR_CLIENT_SECRET=

# Must exactly match a Redirect URI registered on your Smartcar application.
SMARTCAR_REDIRECT_URI=http://localhost:5173/callback

# true  -> use Smartcar's simulated test-mode vehicles (no real car needed)
# false -> live mode (real Teslas connected via Smartcar Connect + Tesla auth)
SMARTCAR_TEST_MODE=false

# Where this connector listens, and where SpacetimeDB is.
PORT=3001
STDB_URI=ws://127.0.0.1:3000
VOLTPASS_MODULE=voltpass

# Expected parked location for the community garage (geofence center) and the
# radius (meters) within which a vehicle is considered "parked where expected".
VOLTPASS_GEOFENCE_LAT=47.6396
VOLTPASS_GEOFENCE_LNG=-122.1284
VOLTPASS_GEOFENCE_RADIUS_M=150
